<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Attributes for XIME Components -->
    <attr name="xoerisGravity" format="flags">
        <flag name="top" value="0x30" />
        <flag name="bottom" value="0x50" />
        <flag name="left" value="0x03" />
        <flag name="right" value="0x05" />
        <flag name="center_vertical" value="0x10" />
        <flag name="fill_vertical" value="0x70" />
        <flag name="center_horizontal" value="0x01" />
        <flag name="fill_horizontal" value="0x07" />
        <flag name="center" value="0x11" />
        <flag name="fill" value="0x77" />
        <flag name="clip_vertical" value="0x80" />
        <flag name="clip_horizontal" value="0x08" />
        <flag name="start" value="0x00800003" />
        <flag name="end" value="0x00800005" />
    </attr>

    <!-- Component System Attributes -->
    <declare-styleable name="XoerisComponent">
        <attr name="xoerisComponentState" format="enum">
            <enum name="idle" value="0" />
            <enum name="active" value="1" />
            <enum name="pressed" value="2" />
            <enum name="focused" value="3" />
            <enum name="disabled" value="4" />
            <enum name="loading" value="5" />
            <enum name="error" value="6" />
        </attr>
        <attr name="xoerisComponentStyle" format="reference" />
    </declare-styleable>
</resources>
