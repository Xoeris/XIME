<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Trigger Attributes -->
    <declare-styleable name="Trigger">
        <attr name="xoerisTriggerType" format="enum">
            <enum name="primary"   value="0" />
            <enum name="secondary" value="1" />
            <enum name="accent"    value="2" />
            <enum name="ghost"     value="3" />
        </attr>
        <attr name="xoerisTriggerIcon" format="reference" />
        <attr name="xoerisText" format="string" />
    </declare-styleable>
</resources>
