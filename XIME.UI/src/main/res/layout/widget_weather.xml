<?xml version="1.0" encoding="utf-8"?>
<xime.ui.layout.BlurLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:xoerisCornerRadius="32dp"
    app:xoerisShowBorder="true"
    app:xoerisBlurType="none">

    <xime.ui.layout.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Cloud Layer (Full Scale of the Card) -->
        <xime.ui.view.View
            android:id="@+id/weather_cloud_layer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="-10dp"
            android:layout_marginEnd="-10dp"
            android:layout_marginTop="-10dp"
            android:layout_marginBottom="-10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Top Section: Location and User -->
        <xime.ui.layout.LinearLayout
            android:id="@+id/weather_location_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <xime.ui.view.PictureView
                android:id="@+id/weather_location_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/xoeris_location"
                app:tint="#B0FFFFFF" />

            <xime.ui.view.TextView
                android:id="@+id/weather_location_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="City, States"
                android:textColor="#B0FFFFFF"
                android:textSize="14sp" />
        </xime.ui.layout.LinearLayout>

        <xime.ui.layout.BlurLayout
            android:id="@+id/weather_user_avatar_container"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:xoerisCornerRadius="12dp"
            app:xoerisGlassOpacity="0.8"
            app:xoerisBlurType="crystal"
            app:xoerisShowBorder="false">

            <xime.ui.view.PictureView
                android:id="@+id/weather_user_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/xoeris_person" />
        </xime.ui.layout.BlurLayout>

        <!-- Middle Section: Temperature and Condition -->
        <xime.ui.view.TextView
            android:id="@+id/weather_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="20dp"
            android:text="28°"
            android:textColor="#FFFFFF"
            android:textSize="64sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/weather_location_container" />

        <xime.ui.view.TextView
            android:id="@+id/weather_condition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="Pretty Sunny"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/weather_temp" />

        <!-- Sun Path and Time -->
        <xime.ui.view.View
            android:id="@+id/weather_sun_path"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/weather_location_container" />

        <xime.ui.view.PictureView
            android:id="@+id/weather_sun_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:src="@drawable/xoeris_ai_sparkle"
            app:layout_constraintBottom_toTopOf="@+id/weather_temp"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="#FFD600" />

        <xime.ui.view.TextView
            android:id="@+id/weather_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HH:MM:SS A"
            android:textColor="#B0FFFFFF"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@+id/weather_condition"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <xime.ui.view.TextView
            android:id="@+id/weather_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:text="Feb 2, 2025"
            android:textColor="#B0FFFFFF"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@+id/weather_condition"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Bottom Cards -->
        <xime.ui.layout.ConstraintLayout
            android:id="@+id/weather_cards_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintTop_toBottomOf="@+id/weather_condition">

            <!-- AQI Card -->
            <xime.ui.layout.BlurLayout
                android:id="@+id/weather_aqi_card"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginEnd="8dp"
                app:xoerisCornerRadius="24dp"
                app:xoerisGlassOpacity="0.8"
                app:xoerisBlurType="crystal"
                app:xoerisShowBorder="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/weather_cloud_card"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <xime.ui.layout.LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <xime.ui.layout.RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <xime.ui.view.TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Air Quality Index"
                            android:textColor="#80000000"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <xime.ui.view.PictureView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_alignParentEnd="true"
                            android:src="@drawable/xoeris_ai_sparkle"
                            app:tint="#000000" />
                    </xime.ui.layout.RelativeLayout>

                    <xime.ui.view.TextView
                        android:id="@+id/weather_aqi_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="0"
                        android:textColor="#000000"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <xime.ui.view.TextView
                        android:id="@+id/weather_aqi_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Moderate"
                        android:textColor="#80000000"
                        android:textSize="12sp" />

                    <xime.ui.bar.LinearProgressBar
                        android:id="@+id/weather_aqi_bar"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="12dp"
                        app:xoerisProgress="72"
                        app:xoerisMax="300"
                        app:xoerisProgressStyle="style2"
                        app:xoerisProgressColor="#FFD600"
                        app:xoerisTrackColor="#F0F0F0" />

                </xime.ui.layout.LinearLayout>
            </xime.ui.layout.BlurLayout>

            <!-- Cloud Cover Card -->
            <xime.ui.layout.BlurLayout
                android:id="@+id/weather_cloud_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:xoerisCornerRadius="24dp"
                app:xoerisGlassOpacity="0.8"
                app:xoerisBlurType="crystal"
                app:xoerisShowBorder="false"
                app:layout_constraintStart_toEndOf="@+id/weather_aqi_card"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <xime.ui.layout.LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <xime.ui.layout.RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <xime.ui.view.TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cloud Cover"
                            android:textColor="#80000000"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <xime.ui.view.PictureView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_alignParentEnd="true"
                            android:src="@drawable/xoeris_dashboard"
                            app:tint="#000000" />
                    </xime.ui.layout.RelativeLayout>

                    <xime.ui.view.TextView
                        android:id="@+id/weather_cloud_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="100%"
                        android:textColor="#000000"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <xime.ui.view.TextView
                        android:id="@+id/weather_cloud_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clean"
                        android:textColor="#80000000"
                        android:textSize="12sp" />

                    <xime.ui.bar.LinearProgressBar
                        android:id="@+id/weather_cloud_bar"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="12dp"
                        app:xoerisProgress="5"
                        app:xoerisMax="100"
                        app:xoerisProgressStyle="style2"
                        app:xoerisProgressColor="#FFD600"
                        app:xoerisTrackColor="#F0F0F0" />

                </xime.ui.layout.LinearLayout>
            </xime.ui.layout.BlurLayout>

        </xime.ui.layout.ConstraintLayout>

        <!-- Bottom Toolbar -->
        <xime.ui.layout.ConstraintLayout
            android:id="@+id/weather_bottom_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintTop_toBottomOf="@+id/weather_cards_container"
            app:layout_constraintBottom_toBottomOf="parent">

            <xime.ui.menu.FooterMenu
                android:id="@+id/weather_footer_menu"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="16dp"
                app:xoerisMenu="@menu/weather_footer_menu"
                app:xoerisIconSize="24dp"
                app:xoerisCornerRadius="40dp"
                app:xoerisGlassOpacity="0.8"
                app:xoerisBlurType="crystal"
                app:xoerisShowBorder="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/weather_add_button"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </xime.ui.layout.ConstraintLayout>

    </xime.ui.layout.ConstraintLayout>

</xime.ui.layout.BlurLayout>

