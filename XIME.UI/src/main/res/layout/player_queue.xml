<?xml version="1.0" encoding="utf-8"?>
<xime.ui.layout.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <xime.ui.layout.LinearLayout
        android:id="@+id/queueHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <xime.ui.view.TextView
            android:id="@+id/queueTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Playing Queue"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

        <xime.ui.view.TextView
            android:id="@+id/queueStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 tracks"
            android:textSize="14sp"
            android:alpha="0.7"
            android:textColor="?attr/colorOnSurface" />

    </xime.ui.layout.LinearLayout>

    <xime.ui.layout.ReflectLayout
        android:id="@+id/queueSineReflect"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="8dp"
        app:xoerisOrientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/queueHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <xime.media.ui.OrbitLayout
            android:id="@+id/queueRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </xime.ui.layout.ReflectLayout>

</xime.ui.layout.ConstraintLayout>
