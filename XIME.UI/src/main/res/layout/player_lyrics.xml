<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lyricsPageContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <xime.ui.layout.ReflectLayout
        android:id="@+id/lyricsSineReflect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:xoerisOrientation="vertical">

        <xime.ui.layout.FlowLayout
            android:id="@+id/lyricsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="32dp">

            <xime.media.ui.LyricsView
                android:id="@+id/lyricsView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </xime.ui.layout.FlowLayout>
    </xime.ui.layout.ReflectLayout>

    <xime.ui.common.IconButton
        android:id="@+id/btnSyncLyrics"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:src="@drawable/xoeris_lyrics"
        android:visibility="gone"
        app:xoerisCornerRadius="24dp"
        app:xoerisBlurRadius="10" />
</FrameLayout>
