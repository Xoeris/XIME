<?xml version="1.0" encoding="utf-8"?>
<xime.ui.layout.RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <xime.ui.layout.ConstraintLayout
        android:id="@+id/mainContentLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <xime.ui.layout.ReflectLayout
            android:id="@+id/ReflectLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/nav_host_fragment"
                android:background="@android:color/transparent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </xime.ui.layout.ReflectLayout>
    </xime.ui.layout.ConstraintLayout>
    <xime.ui.menu.HeaderMenu
        android:id="@+id/headerAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:elevation="0dp"
        app:xoerisBlurRadius="50"
        app:xoerisBlurType="glass"
        app:xoerisBottomLeftCornerRadius="30dp"
        app:xoerisBottomRightCornerRadius="30dp"
        app:xoerisCornerRadius="30dp"
        app:xoerisTopLeftCornerRadius="0dp"
        app:xoerisTopRightCornerRadius="0dp">
        <xime.ui.common.IconButton
            android:id="@+id/navExitButton"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/xoeris_exit"
            android:scaleType="centerInside"
            android:contentDescription="Exit"
            android:layout_marginStart="16dp"
            android:layout_alignParentStart="true"
            android:elevation="1dp"
            app:tint="?attr/colorOnBackground"/>
    </xime.ui.menu.HeaderMenu>
    <xime.ui.layout.LinearLayout
        android:orientation="vertical"
        android:id="@+id/staticBottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <xime.ui.menu.FooterMenu
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:xoerisBlurRadius="50"
            app:xoerisBlurType="glass"
            app:xoerisBottomLeftCornerRadius="32dp"
            app:xoerisBottomRightCornerRadius="32dp"
            app:xoerisCornerRadius="30dp"
            app:xoerisMenu="@menu/bottom_navigation_menu"
            app:xoerisTopLeftCornerRadius="32dp"
            app:xoerisTopRightCornerRadius="32dp"/>
    </xime.ui.layout.LinearLayout>
</xime.ui.layout.RelativeLayout>

