<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Widget Styles -->
    <style name="Widget.Xoeris" parent="android:Widget" />

    <style name="Widget.Xoeris.View">
        <item name="xoerisElevation">0dp</item>
        <item name="xoerisCornerRadius">@dimen/xoeris_radius_medium</item>
    </style>

    <style name="Widget.Xoeris.CardBase" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/xoeris_radius_medium</item>
        <item name="cardElevation">@dimen/xoeris_card_elevation</item>
        <item name="xoerisRippleColor">@color/xoeris_ripple_light</item>
    </style>

    <style name="Widget.Xoeris.GlassBase">
        <item name="xoerisBlurRadius">70</item>
        <item name="xoerisGlassTint">@color/xoeris_glass_white</item>
        <item name="xoerisGlassOpacity">0.1</item>
        <item name="xoerisCornerRadius">@dimen/xoeris_radius_extra_large</item>
        <item name="xoerisShowBorder">true</item>
        <item name="xoerisShowHighlight">true</item>
    </style>

    <style name="Widget.Xoeris.Trigger" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/xoeris_radius_medium</item>
        <item name="android:minHeight">@dimen/xoeris_trigger_height</item>
    </style>

    <style name="Widget.Xoeris.Trigger.Accent">
        <item name="backgroundTint">@color/xoeris_accent</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="iconTint">@android:color/black</item>
    </style>

    <style name="Widget.Xoeris.Badge">
        <item name="android:background">@drawable/xoeris_card_background</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/xoeris_text_primary_light</item>
    </style>

    <!-- BottomPanel (BottomSheetDialog) Styles -->
    <style name="Xoeris.BottomPanel" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="bottomSheetStyle">@style/Xoeris.BottomSheetStyle</item>
    </style>

    <style name="Xoeris.BottomSheetStyle" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearance">@style/Xoeris.ShapeAppearance.BottomSheet</item>
    </style>

    <style name="Xoeris.ShapeAppearance.BottomSheet" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>

