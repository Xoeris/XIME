<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Xoeris Theme -->
    <style name="Theme.Xoeris" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Core Colors -->
        <item name="colorPrimary">@color/xoeris_primary</item>
        <item name="colorOnPrimary">@android:color/black</item>
        <item name="colorAccent">@color/xoeris_accent</item>

        <!-- Status & Nav Bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>

        <!-- Default Component Styles -->
        <item name="materialCardViewStyle">@style/Widget.Xoeris.CardBase</item>
    </style>

    <!-- Glassy Variant -->
    <style name="Theme.Xoeris.Glass" parent="Theme.Xoeris">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <!-- Dark Variant -->
    <style name="Theme.Xoeris.Dark" parent="Theme.Xoeris">
        <item name="android:windowBackground">@color/xoeris_bg_dark</item>
    </style>
</resources>



